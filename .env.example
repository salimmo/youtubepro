# ---------------------------------------------------------------------------
# YouTube Pro – Beispielkonfiguration
# Lokal: `cp .env.example .env` und Werte eintragen.
# Coolify: Diese Variablen im Coolify-Dashboard unter "Environment Variables"
# setzen. Dort gesetzte Werte haben Vorrang vor der .env-Datei.
# ---------------------------------------------------------------------------

# Pflicht für die YouTube-Suche (Seite "Recherche").
# Google Cloud Console: "YouTube Data API v3" aktivieren, API-Schlüssel erstellen.
YOUTUBE_API_KEY=

# Pflicht für KI-Insights, fundierte Ideen, Skript-Writer und Thumbnail-Creator.
# Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.7-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# Sprache der KI-generierten Inhalte (Insights, Ideen, Skripte, Thumbnail-Text).
# Standard ist Deutsch. Beispiel für Englisch: OUTPUT_LANGUAGE=English
OUTPUT_LANGUAGE=German (Deutsch)

# Optional: HTTP-Port, Standard 5000.
PORT=5000

# Optional: Bind-Adresse, Standard Loopback (nur lokal erreichbar).
# Im Docker-Image ist HOST=0.0.0.0 bereits gesetzt. Außerhalb von Docker nur
# mit Basic Auth oder einem geschützten Reverse-Proxy auf 0.0.0.0 setzen.
HOST=127.0.0.1

# ---------------------------------------------------------------------------
# Server-Deployment (Coolify / Docker)
# ---------------------------------------------------------------------------

# Hinter einem Reverse-Proxy (Coolify/Traefik) auf 1 setzen, damit Ratenlimits
# die echte Client-Adresse aus X-Forwarded-For verwenden.
# Im Docker-Image bereits TRUST_PROXY=1.
TRUST_PROXY=

# Dringend empfohlen für öffentlich erreichbare Deployments: HTTP Basic Auth.
# Die App hat keinen eigenen Login, verwendet aber kostenpflichtige API-Schlüssel.
# Beide Werte setzen, um den Schutz zu aktivieren (/api/health bleibt frei).
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

# Einstellungen-Seite auch über das Netz erlauben (Schlüssel/Modelle speichern).
# Wirkt nur, wenn BASIC_AUTH_USER und BASIC_AUTH_PASSWORD gesetzt sind.
# Ohne diese Option zeigt die Einstellungen-Seite auf dem Server nur einen Hinweis.
ALLOW_REMOTE_SETTINGS=false

# Pfad der .env-Datei, in die die Einstellungen-Seite schreibt.
# Im Docker-Image: /app/data/.env (Volume /app/data mounten, damit es persistiert).
ENV_FILE=
