# ---------------------------------------------------------------------------
# YouTube Pro – Beispielkonfiguration
# Lokal: `cp .env.example .env` und Werte eintragen.
# Coolify: Diese Variablen im Coolify-Dashboard unter "Environment Variables"
# setzen. Dort gesetzte Werte haben Vorrang vor der .env-Datei.
# ---------------------------------------------------------------------------

# Pflicht für die YouTube-Suche (Seite "Recherche").
# Google Cloud Console: "YouTube Data API v3" aktivieren, API-Schlüssel erstellen.
YOUTUBE_API_KEY=

# Pflicht für KI-Insights, fundierte Ideen, Skript-Writer und Thumbnail-Creator.
# Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.7-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# Sprache der KI-generierten Inhalte (Insights, Ideen, Skripte, Thumbnail-Text).
# Standard ist Deutsch. Beispiel für Englisch: OUTPUT_LANGUAGE=English
OUTPUT_LANGUAGE=German (Deutsch)

# ---------------------------------------------------------------------------
# Login, Benutzer und Aktivitätsprotokoll (PostgreSQL)
# ---------------------------------------------------------------------------

# Pflicht. Verbindung zur PostgreSQL-Datenbank. In Coolify eine PostgreSQL-
# Ressource anlegen und die interne URL hier eintragen, z. B.
# postgres://postgres:PASSWORT@HOSTNAME:5432/postgres
DATABASE_URL=

# Optional: TLS zur Datenbank erzwingen (bei externen Datenbanken).
DATABASE_SSL=false

# Erster Admin. Wird nur angelegt, wenn die Datenbank noch keine Benutzer hat.
# Danach werden Benutzer im Admin-Bereich der App verwaltet.
ADMIN_USER=admin
ADMIN_PASSWORD=
ADMIN_DISPLAY_NAME=Admin

# Optional: Gültigkeit einer Anmeldung in Stunden (Standard 720 = 30 Tage).
SESSION_TTL_HOURS=720

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

# Optional: HTTP-Port, Standard 5000.
PORT=5000

# Optional: Bind-Adresse, Standard Loopback (nur lokal erreichbar).
# Im Docker-Image ist HOST=0.0.0.0 bereits gesetzt.
HOST=127.0.0.1

# Hinter einem Reverse-Proxy (Coolify/Traefik) auf 1 setzen, damit Ratenlimits
# und Protokoll die echte Client-Adresse aus X-Forwarded-For verwenden und das
# Session-Cookie als "Secure" gesetzt wird. Im Docker-Image bereits TRUST_PROXY=1.
TRUST_PROXY=

# Pfad der .env-Datei, in die die Einstellungen-Seite (nur Admins) schreibt.
# Im Docker-Image: /app/data/.env (Volume /app/data mounten, damit es persistiert).
ENV_FILE=
